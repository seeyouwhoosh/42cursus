      "boundElements": null,
      "updated": 1762206166999,
      "link": null,
      "locked": false,
      "text": "Nota: si se trata de un comando normal (no built-\nin), usar variación del exec(char *cmd, char **env)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nota: si se trata de un comando normal (no built-in), usar variación del exec(char *cmd, char **env)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "xt7SJ0wEEcEaHns503klG",
      "type": "text",
      "x": -315.8046157269255,
      "y": -464.706733312953,
      "width": 764.2458844866071,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
