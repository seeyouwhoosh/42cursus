    {
      "id": "9jRnJHwiawT0MvqB8qAKT",
      "type": "text",
      "x": 1513.2716956574247,
      "y": 1040.441684067274,
      "width": 812.1593017578125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1971c2",
