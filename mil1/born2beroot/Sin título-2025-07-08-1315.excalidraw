      "seed": 426840125,
      "version": 442,
      "versionNonce": 169372221,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1752141202533,
      "link": null,
      "locked": false,
      "text": "Es un sistema de control de acceso\npara Linux, que limita los permisos de\nlas aplicaciones y procesos, protegiendo\nasí de operaciones perniciosas, tanto\nexternas como internas",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Es un sistema de control de acceso para Linux, que limita los permisos de las aplicaciones y procesos, protegiendo así de operaciones perniciosas, tanto externas como internas",
      "autoResize": false,
      "lineHeight": 1.25
    },
