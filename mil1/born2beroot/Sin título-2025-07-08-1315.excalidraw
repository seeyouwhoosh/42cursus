      "boundElements": [],
      "updated": 1752250855784,
      "link": null,
      "locked": false,
      "text": "Defaults  passwd_tries=3\n\n\nDefaults  badpass_message=\"Mensaje de error personalizado\"\n\n\nDefaults  logfile=\"/var/log/sudo/sudo.log\"\n\n\nDefaults  log_input,log_output\n\n\nDefaults  iolog_dir=\"/var/log/sudo\"\n\n\nDefaults  requiretty\n\n\nDefaults  secure_path=\"/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin\"",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Defaults  passwd_tries=3\n\n\nDefaults  badpass_message=\"Mensaje de error personalizado\"\n\n\nDefaults  logfile=\"/var/log/sudo/sudo.log\"\n\n\nDefaults  log_input,log_output\n\n\nDefaults  iolog_dir=\"/var/log/sudo\"\n\n\nDefaults  requiretty\n\n\nDefaults  secure_path=\"/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin\"",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "uxfjG2bxfKPe9DTz1WBeQ",
      "type": "text",
      "x": 1510.144467400901,
      "y": 46.76348796436139,
      "width": 559.3995361328125,
      "height": 525,
