      "type": "text",
      "x": 1513.2716956574247,
      "y": 1002.2273983529883,
      "width": 1051.9190324253007,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
