      "boundElements": [],
      "updated": 1758974201093,
      "link": null,
      "locked": false,
      "text": "Hostname  = xwu42\n\nParticiones (16GB)\n*Partición 1:\n    * /boot: (500 MB)\n* Partición sin montar:\n    * /home: (2.6GB) ext4; mount in /home\n    * /root: (3GB) ext4; mount in /\n    * /srv: (1.2GB) /srv\n    * /swap: (1.2GB) swap area\n    * /tmp: (1.6GB) ext4; mount in /tmp\n    * /var: (1.6GB) ext4; mount in /var\n    * /var-log: (2GB) ext4; mount in /var/log\n\nPara posteriormente ver las particiones:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hostname  = xwu42\n\nParticiones (16GB)\n*Partición 1:\n    * /boot: (500 MB)\n* Partición sin montar:\n    * /home: (2.6GB) ext4; mount in /home\n    * /root: (3GB) ext4; mount in /\n    * /srv: (1.2GB) /srv\n    * /swap: (1.2GB) swap area\n    * /tmp: (1.6GB) ext4; mount in /tmp\n    * /var: (1.6GB) ext4; mount in /var\n    * /var-log: (2GB) ext4; mount in /var/log\n\nPara posteriormente ver las particiones:",
      "autoResize": true,
      "lineHeight": 1.25
    },
