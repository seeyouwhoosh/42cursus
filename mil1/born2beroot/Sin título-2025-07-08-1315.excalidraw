      "versionNonce": 270472125,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1758974146301,
      "link": null,
      "locked": false,
      "text": "password [success=1 default=ignore] pam_succeed_if.so user != root\n\n\npassword requisite pam_pwquality.so difok=7\n\n\npassword requisite pam_pwquality.so retry=3 minlen=10 dcredit=-1 ucredit=-1 lcredit=-1\nmaxrepeat=3 usercheck=1 enforce_for_root",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "password [success=1 default=ignore] pam_succeed_if.so user != root\n\n\npassword requisite pam_pwquality.so difok=7\n\n\npassword requisite pam_pwquality.so retry=3 minlen=10 dcredit=-1 ucredit=-1 lcredit=-1 maxrepeat=3 usercheck=1 enforce_for_root",
      "autoResize": false,
      "lineHeight": 1.25
    },
