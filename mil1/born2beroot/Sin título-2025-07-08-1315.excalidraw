    {
      "id": "w-DquVmEHFW1bM-FTNV7F",
      "type": "text",
      "x": 366.9312414550783,
      "y": -148.5,
      "width": 403.07442284781143,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 1528669569,
      "version": 632,
      "versionNonce": 700527137,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1751970253226,
      "link": null,
      "locked": false,
      "text": "Debian parece el más estable entre los\nsistemas operativos. Es bastante\ngeneral-purpose\n\nRocky es como el Red Hat pero open\nsource, algo que ya había sido algo\nparecido CentOS. En lo que más difiere\ncon Debian es en package management,\nque usa rpm.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Debian parece el más estable entre los sistemas operativos. Es bastante general-purpose\n\nRocky es como el Red Hat pero open source, algo que ya había sido algo parecido CentOS. En lo que más difiere con Debian es en package management, que usa rpm.",
      "autoResize": false,
      "lineHeight": 1.25
    },
