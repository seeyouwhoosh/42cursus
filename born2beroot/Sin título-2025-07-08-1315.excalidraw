    {
      "id": "uxfjG2bxfKPe9DTz1WBeQ",
      "type": "text",
      "x": 1510.144467400901,
      "y": 119.26348796436139,
      "width": 557.8195190429688,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
