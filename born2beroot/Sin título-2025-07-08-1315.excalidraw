      "index": "b0l",
      "roundness": null,
      "seed": 271744440,
      "version": 467,
      "versionNonce": 420065208,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752057284488,
      "link": null,
      "locked": false,
      "text": "Printea el nombre del archivo de\nla terminal que está conectada\ncon su standard input. No es\ntty si el standard input no es\nuna terminal",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Printea el nombre del archivo de la terminal que está conectada con su standard input. No es tty si el standard input no es una terminal",
      "autoResize": false,
      "lineHeight": 1.25
    },
