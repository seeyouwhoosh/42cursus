      "link": null,
      "locked": false,
      "text": "Hostname  = xwu42\n\nParticiones:\n* /swap: (1GB)\n* /home: encriptado\n* /boot: creo que no es necesario (1 GB)\n* /root: encriptado (3GB)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hostname  = xwu42\n\nParticiones:\n* /swap: (1GB)\n* /home: encriptado\n* /boot: creo que no es necesario (1 GB)\n* /root: encriptado (3GB)",
      "autoResize": true,
